# Optional overrides for src/lib/config.ts -- copy to .env.local (git-ignored).
# Example: a locally run matching engine (services/matching-engine/dev.js)
# against a scratch vault/verifier on testnet.
# VITE_VAULT_ID=C...
# VITE_VERIFIER_ID=C...
# VITE_ENCLAVE_ID=<64 hex chars>
# VITE_ENGINE_ADDRESS=G...
# VITE_ENGINE_URL=http://localhost:8787
